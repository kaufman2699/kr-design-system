{
  "name": "@kaufman2699/kr-design-system",
  "version": "0.1.0",
  "description": "Kaufman Rossin React component library with Tailwind CSS design tokens",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-config": "./tailwind.config.js"
  },
  "files": [
    "dist",
    "tailwind.config.js"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsup && pnpm build:css",
    "build:css": "postcss src/styles/globals.css -o dist/styles.css",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:catalog": "tsx scripts/generate-catalog.ts && tsx scripts/generate-tokens.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm generate:catalog && pnpm build",
    "prepare": "node -e \"try{require('simple-git-hooks/cli')}catch{}\" || true"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-vitest": "^10.4.5",
    "@storybook/react": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.0",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.5",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaufman2699/kr-design-system.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm test"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
